# Image generation (OpenAI Images API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional video generation via Replicate model predictions
REPLICATE_API_TOKEN=
REPLICATE_MODEL=owner/model

# Persistent generated media files
AI_ADS_MEDIA_PATH=./media
AI_ADS_PUBLIC_BASE_URL=http://localhost:8000
