# Chat/strategy/storyboard agents
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Actual image generation through the OpenAI Images API
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional asynchronous video generation via Replicate.
# Select a model whose input schema accepts prompt, aspect_ratio and duration.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=owner/model

# Docker Compose sets persistent media and database paths automatically.
